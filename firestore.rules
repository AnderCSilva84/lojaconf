rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/main {
      allow read: if true;
      // Troque o valor abaixo pelo UID do proprietário no Firebase Auth.
      allow write: if request.auth != null
        && request.auth.uid == '8BYCyjUAvqciK29RCe26RUNX7IM2'
        && request.resource.data.keys().hasAll(['name', 'products', 'categories', 'whatsapp']);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
