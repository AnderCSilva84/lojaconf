rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Conta da agência. Em uma etapa futura, isso pode ser migrado para
    // custom claims gerenciadas exclusivamente pelo backend.
    function isSuperAdmin() {
      return signedIn()
        && request.auth.uid in ['8BYCyjUAvqciK29RCe26RUNX7IM2'];
    }

    function membership(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid));
    }

    function isActiveMember(storeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid))
        && membership(storeId).data.get('active', true) == true;
    }

    function canEditStore(storeId) {
      return isSuperAdmin()
        || (isActiveMember(storeId)
          && membership(storeId).data.role in ['owner', 'editor']);
    }

    function isStoreOwner(storeId) {
      return isSuperAdmin()
        || (isActiveMember(storeId)
          && membership(storeId).data.role == 'owner');
    }

    function validStore(storeId) {
      return request.resource.data.storeId == storeId
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.keys().hasAll([
          'storeId', 'status', 'name', 'products', 'categories', 'whatsapp'
        ]);
    }

    match /stores/{storeId} {
      allow read: if resource.data.status == 'active' || canEditStore(storeId);
      allow create, update: if canEditStore(storeId) && validStore(storeId);
      allow delete: if isSuperAdmin();

      match /members/{uid} {
        allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, update: if isStoreOwner(storeId)
          && request.resource.data.role in ['owner', 'editor', 'viewer'];
        allow delete: if isStoreOwner(storeId);
      }

      // Dados internos: o superadministrador da plataforma não recebe acesso
      // automático. Ele precisa ser membro explícito da loja para consultá-los.
      match /{privateCollection}/{documentId} {
        allow read, write: if privateCollection in [
          'orders', 'sales', 'inventoryMovements', 'cashMovements'
        ] && isActiveMember(storeId);
      }
    }

    match /users/{uid} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'lastStoreId']);
      allow delete: if isSuperAdmin();
    }

    // Compatibilidade temporária durante a migração da primeira loja.
    match /site/main {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
